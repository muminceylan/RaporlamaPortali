    };

    private static readonly Dictionary<string, string> _navigasyonUrlMap = new()
    {
        ["anasayfa"]                  = "/",
        ["uretim-giris"]              = "/uretimden-giris-fisi",
        ["promosyon-cikis"]           = "/promosyon-cikis-fisi",
        ["satinalma-irsaliyeleri"]    = "/satinalma-irsaliyeleri",
        ["toptan-satis-irsaliyeleri"] = "/toptan-satis-irsaliyeleri",
        ["kasa-hareketleri"]          = "/kasa-hareketleri",
        ["kur-bilgileri"]             = "/kur-bilgileri",
        ["stok-durumu"]               = "/stok-durumu",
        ["gubre-stok"]                = "/gubre-stok",
        ["gubre-ciro"]                = "/gubre-ciro",
        ["cay-durum"]                 = "/cay-durum",
        ["cari-bakiye"]               = "/cari-bakiye",
        ["cari-hareket"]              = "/cari-hareket",
        ["malzeme-hareket"]           = "/malzeme-hareket-listesi",
        ["efatura"]                   = "/efatura",
        ["efatura-aktar"]             = "/efatura-aktar",
        ["efatura-logo-kontrol"]      = "/efatura-logo-kontrol",
        ["seker-dairesi"]             = "/seker-dairesi",
        ["pancar"]                    = "/pancar-raporu",
        ["yan-urunler"]               = "/yan-urunler",
        ["ozet-rapor"]                = "/yan-urunler",   // alias: Özet Rapor = Yan Ürünler
        ["tarim-kredi"]               = "/tarim-kredi-raporu",
        ["sabnet-kantar"]             = "/sabnet-kantar-hareketleri",
        ["mustahsil"]                 = "/mustahsil-karsilastirma",
        ["finans-rapor"]              = "/finans-raporu",
        ["mutabakat"]                 = "/mutabakat",
        ["kur-farki"]                 = "/karsi-firma-kur-farki",
        ["odeme-kontrol"]             = "/odeme-kontrol",
        ["odeme-dosyasi"]             = "/odeme-dosyasi",
        ["odeme-karsilastir"]         = "/odeme-karsilastir",
        ["satis-faturasi-aktar"]      = "/satis-faturasi-aktar",
        ["ayarlar"]                   = "/ayarlar",
        ["mail-ayarlari"]             = "/mail-ayarlari",
        ["whatsapp-ayarlari"]         = "/whatsapp-ayarlari",
        ["banka-hesap-ayarlari"]      = "/banka-hesap-ayarlari",
        ["sirlar"]                    = "/sirlar",
        ["evrak-arsivi"]              = "/evrak-arsivi",
        ["evrak-ekle"]                = "/evrak-ekle",
        ["tesisler"]                  = "/tesisler",
        ["belge-tipleri"]             = "/belge-tipleri",
        ["isletme-malzemeleri"]       = "/isletme-malzemeleri-raporu",
        ["kantar-logo-karsilastirma"] = "/kantar-logo-karsilastirma",
        ["sabnet-logo-karsilastir"]   = "/sabnet-logo-karsilastir",
    };

    private async Task KomutuYorumla(string metin)
    {
        _isleniyor = true;
        StateHasChanged();
        try
        {
            // Sayfanın tool'larına global navigasyon tool'unu otomatik ekle
            var birlesik = new List<SesliKomutTool>(EffTools) { _navigasyonTool };
            var intent = await Voice.KomutuYorumlaAsync(metin, EffSayfaAdi, birlesik, EffEkContext);
            if (!intent.Anlasildi)
            {
                _sonHata = intent.Hata ?? "Komut anlaşılamadı.";
                if (!string.IsNullOrWhiteSpace(intent.OnayMetni))
                    _sonHata += " — " + intent.OnayMetni;
            }
            else
            {
                // Onay gerektiren listede mi? Liste boşsa tümü onay ister (eski davranış).
                // Komut zinciri ise: içindeki herhangi bir adım onay gerektiriyorsa zincirin tamamı onay ister.
                var effOnay = EffOnay;
                bool onayGerek;
                if (intent.Action == "komut_zinciri" && intent.Adimlar != null && intent.Adimlar.Count > 0)
                {
                    onayGerek = effOnay == null
                                || effOnay.Count == 0
                                || intent.Adimlar.Any(a => effOnay.Contains(a.Action));
                }
                else
                {
                    onayGerek = effOnay == null
                                || effOnay.Count == 0
                                || effOnay.Contains(intent.Action);
                }

                if (onayGerek)
                {
                    _bekleyenIntent = intent;
                    _onayAcik = true;
                }
                else
                {
                    // Anında çalıştır — kısa bir bilgi mesajı göster
                    Snackbar.Add(intent.OnayMetni, Severity.Info);
                    await AksiyonuCalistir(intent);
                }
            }
        }
        catch (Exception ex)
        {
            _sonHata = "Yorumlama hata: " + ex.Message;
        }
        finally
        {
            _isleniyor = false;
            StateHasChanged();
        }
    }

    private void OnayIptal()
    {
        _onayAcik = false;
        _bekleyenIntent = null;
        Snackbar.Add("Komut iptal edildi.", Severity.Info);
    }

    private async Task OnayEvet()
    {
        var intent = _bekleyenIntent;
        _onayAcik = false;
        _bekleyenIntent = null;
        StateHasChanged();
        if (intent != null) await AksiyonuCalistir(intent);
    }

    /// <summary>
    /// Aksiyonu sayfa tarafına ilet — önce parametre handler (varsa), yoksa
    /// VoiceContextService'deki handler. Komut zinciri ise sırayla işle.
    /// `sayfa_git` özel olarak Navigation yapar; komut zinciri içinde gelirse
    /// sonraki adımlar BekleyenAdimlar kuyruğuna kaydedilir.
    /// </summary>
    private async Task AksiyonuCalistir(VoiceIntent intent)
    {
        // Komut zinciri — sayfa_git dahil sırayla işle, sayfa_git'ten sonrası kuyruğa
        if (intent.Action == "komut_zinciri" && intent.Adimlar != null && intent.Adimlar.Count > 0)
        {
            for (int i = 0; i < intent.Adimlar.Count; i++)
            {
                var adim = intent.Adimlar[i];

                if (adim.Action == "sayfa_git")
                {
                    // Sonraki adımları kuyruğa kaydet (yeni sayfada çalışacaklar)
                    var kalan = intent.Adimlar.Skip(i + 1).ToList();
                    if (kalan.Count > 0)
                    {
                        VoiceCtx.BekleyenAdimlar = new Queue<VoiceIntent>(kalan);
                        Snackbar.Add($"[{i + 1}/{intent.Adimlar.Count}] Sayfa değiştiriliyor — {kalan.Count} işlem yeni sayfada çalışacak.",
                                     Severity.Info);
                    }
                    else
                    {
                        Snackbar.Add($"[{i + 1}/{intent.Adimlar.Count}] Sayfa değiştiriliyor.", Severity.Info);
                    }
                    await AksiyonuCalistir(adim); // sayfa_git burada Navigation yapar
                    return;                       // Sayfa değişti, kalan adımlar yeni sayfada çalışacak
                }

                Snackbar.Add($"[{i + 1}/{intent.Adimlar.Count}] {adim.Action}", Severity.Info);
                await AksiyonuCalistir(adim);
                await Task.Delay(150);
            }
            return;
        }

        // Navigasyon — sayfa-bazlı handler'a gönderme, doğrudan yönlendir
        if (intent.Action == "sayfa_git")
        {
            var kod = (intent.Params.GetValueOrDefault("sayfa_kodu") as string ?? "").ToLower();
            if (_navigasyonUrlMap.TryGetValue(kod, out var url))
            {
                Snackbar.Add(intent.OnayMetni, Severity.Info);
                Nav.NavigateTo(url);
                return;
            }
            Snackbar.Add($"Bilinmeyen sayfa kodu: {kod}", Severity.Warning);
            return;
        }

        if (OnAksiyon.HasDelegate)
        {
            await OnAksiyon.InvokeAsync(intent);
        }
        else if (VoiceCtx.OnAksiyon != null)
        {
            await VoiceCtx.OnAksiyon(intent);
        }
        else
        {
            Snackbar.Add("Bu sayfa bu aksiyonu desteklemiyor.", Severity.Warning);
        }
    }

    /// <summary>
    /// Yeni sayfa Register edince çağrılır — VoiceCtx.BekleyenAdimlar varsa,
    /// onları kuyruktan çıkar ve sırayla çalıştır.
    /// </summary>
    private async Task BekleyenAdimlariCalistirEgerVarsa()
    {
        // Yeni sayfa tool register etmiş olmalı (Tools dolu); yoksa nav olmadı sayma
        if (VoiceCtx.BekleyenAdimlar == null || VoiceCtx.BekleyenAdimlar.Count == 0) return;
        if (VoiceCtx.Tools.Count == 0) return;

        var kuyruk = VoiceCtx.BekleyenAdimlar;
        VoiceCtx.BekleyenAdimlar = null;

        // Sayfa data'sının yüklenmesi için kısa gecikme
        await Task.Delay(700);

        int total = kuyruk.Count;
        int i = 0;
        while (kuyruk.Count > 0)
        {
            i++;
            var adim = kuyruk.Dequeue();
            Snackbar.Add($"[{i}/{total}] {adim.Action}", Severity.Info);
            await AksiyonuCalistir(adim);
            await Task.Delay(200);
        }
    }
}
