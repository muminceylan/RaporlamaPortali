                           "  - 'isletme-malzemeleri' (İşletme Malzemeleri Raporu)\n" +
                           "  - 'kantar-logo-karsilastirma' (Kantar Logo Karşılaştırma)\n" +
                           "  - 'sabnet-logo-karsilastir' (SabNet Logo Karşılaştır)",
                Secenekler = new()
                {
                    "anasayfa", "uretim-giris", "promosyon-cikis",
                    "satinalma-irsaliyeleri", "toptan-satis-irsaliyeleri",
                    "kasa-hareketleri", "kur-bilgileri", "stok-durumu",
                    "gubre-stok", "gubre-ciro", "cay-durum",
                    "cari-bakiye", "cari-hareket", "malzeme-hareket",
                    "efatura", "efatura-aktar", "efatura-logo-kontrol",
                    "seker-dairesi", "pancar", "ozet-rapor", "tarim-kredi",
                    "sabnet-kantar", "mustahsil", "finans-rapor",
                    "mutabakat", "kur-farki", "odeme-kontrol", "odeme-dosyasi",
                    "odeme-karsilastir", "satis-faturasi-aktar",
                    "ayarlar", "mail-ayarlari", "whatsapp-ayarlari",
                    "banka-hesap-ayarlari", "sirlar",
                    "evrak-arsivi", "evrak-ekle", "tesisler", "belge-tipleri",
                    "isletme-malzemeleri", "kantar-logo-karsilastirma",
