    private async Task EtilAlkolExcelIndir()
    {
        if (_ham == null || _baslangic == null || _bitis == null) return;

        var liste = _ham
            .Where(x => (x.ChKod ?? "").StartsWith("120.99.10", StringComparison.OrdinalIgnoreCase)
                        && x.HareketTuru == "TAHSİLAT"
                        && x.Havale > 0)
            .Where(x => string.IsNullOrWhiteSpace(_eTarih)
                        || x.Tarih.ToString("dd.MM.yyyy").Contains(_eTarih.Trim())
                        || x.Tarih.ToString("yyyy-MM-dd").Contains(_eTarih.Trim()))
            .Where(x => MetinEslesir(x.ChKod,                _eChKod))
            .Where(x => MetinEslesir(x.ChUnvani,             _eChUnvan))
            .Where(x => MetinEslesir(x.BankaHesapKodu,       _eBankaKod))
            .Where(x => MetinEslesir(x.BankaHesapAciklamasi, _eBankaAcik))
            .Where(x => MetinEslesir(x.ProjeKodu,            _eProjeKod))
            .Where(x => MetinEslesir(x.IslemNo,              _eIslemNo))
            .Where(x => MetinEslesir(x.FisTuru,              _eFisTuru))
            .Where(x => SayiEslesir(x.Havale,                _eHavale))
            .OrderBy(x => x.Tarih)
            .ToList();

        if (liste.Count == 0)
        {
            Snackbar.Add("İndirilecek kayıt yok.", Severity.Warning);
            return;
        }

        try
        {
            var bytes = Excel.ExportEtilAlkolGelenBedeller(liste, _baslangic.Value, _bitis.Value);
            var fileName = $"EtilAlkol_GelenBedeller_{_baslangic:yyyyMMdd}_{_bitis:yyyyMMdd}.xlsx";
            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add($"{liste.Count} satır Excel'e aktarıldı.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Excel hatası: " + ex.Message, Severity.Error);
        }
    }

