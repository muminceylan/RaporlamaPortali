@page "/finans-raporu"
@using RaporlamaPortali.Models
@using RaporlamaPortali.Services
@inject FinansRaporService FinansService
@inject LogoIslemleriService Logo
@inject ExcelExportService Excel
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject VoiceContextService VoiceCtx

<PageTitle>Finans Raporu</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Savings" Class="mr-2" />
    Finans Raporu
</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="Başlangıç Tarihi" @bind-Date="_baslangic"
                           DateFormat="dd.MM.yyyy" Editable="true"
                           PickerVariant="PickerVariant.Dialog" OpenTo="OpenTo.Year" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudDatePicker Label="Bitiş Tarihi" @bind-Date="_bitis"
                           DateFormat="dd.MM.yyyy" Editable="true"
                           PickerVariant="PickerVariant.Dialog" OpenTo="OpenTo.Year" />
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex align-end flex-wrap gap-1">
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                @foreach (var y in _hizliYillar)
                {
                    var yil = y;
                    <MudButton OnClick="@(() => YilSec(yil))">@yil</MudButton>
                }
            </MudButtonGroup>
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="ml-2">
                <MudButton OnClick="@(() => HizliSec("bu-ay"))">Bu Ay</MudButton>
                <MudButton OnClick="@(() => HizliSec("gecen-ay"))">Geçen Ay</MudButton>
                <MudButton OnClick="@(() => HizliSec("yil-basindan"))">Yıl Başından</MudButton>
                <MudButton OnClick="@(() => HizliSec("tumu"))">2025'ten</MudButton>
            </MudButtonGroup>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="string" Label="Hareket Türü" @bind-Value="_filtreHareketTuru"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                       Placeholder="Tümü">
                <MudSelectItem T="string" Value="@("TAHSİLAT")">TAHSİLAT</MudSelectItem>
                <MudSelectItem T="string" Value="@("ÖDEME")">ÖDEME</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string" Label="Modül" @bind-Value="_filtreModul"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                       Placeholder="Tümü">
                @foreach (var m in _mevcutModuller)
                {
                    <MudSelectItem T="string" Value="@m">@m</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" Label="Serbest Arama (Cari / Açıklama / Proje)"
                          @bind-Value="_arama" Immediate="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" Class="d-flex gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RaporGetir" Disabled="@_yukleniyor">
                @if (_yukleniyor) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Rapor Getir
            </MudButton>
            @if (_ham != null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.FilterAltOff"
                           OnClick="FiltreleriTemizle">
                    Filtreleri Temizle
                </MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_hata != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_hata</MudAlert>
}

@if (_ham != null)
{
    var filtreli = UygulanmisFiltre(_ham);
    var tHavale = filtreli.Sum(x => x.Havale);
    var tCek    = filtreli.Sum(x => x.Cek);
    var tDevir  = filtreli.Sum(x => x.Devir);
    var tDiger  = filtreli.Sum(x => x.Diger);
    var tTahs   = filtreli.Where(x => x.HareketTuru == "TAHSİLAT").Sum(x => x.Havale + x.Cek + x.Devir + x.Diger);
    var tOdeme  = filtreli.Where(x => x.HareketTuru == "ÖDEME"   ).Sum(x => x.Havale + x.Cek + x.Devir + x.Diger);

    <MudGrid Class="mb-3">
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Style="background:#E8F5E9;">
                <MudText Typo="Typo.caption">TAHSİLAT TOPLAM</MudText>
                <MudText Typo="Typo.h6">@tTahs.ToString("N2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Style="background:#FFEBEE;">
                <MudText Typo="Typo.caption">ÖDEME TOPLAM</MudText>
                <MudText Typo="Typo.h6">@tOdeme.ToString("N2")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Style="background:#E3F2FD;">
                <MudText Typo="Typo.caption">NET (TAHSİLAT - ÖDEME)</MudText>
                <MudText Typo="Typo.h6">@((tTahs - tOdeme).ToString("N2"))</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudPaper Class="pa-3" Style="background:#FFF9C4;">
                <MudText Typo="Typo.caption">SATIR SAYISI</MudText>
                <MudText Typo="Typo.h6">@filtreli.Count.ToString("N0") / @_ham.Count.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    var etilAlkolHam = _ham
        .Where(x => (x.ChKod ?? "").StartsWith("120.99.10", StringComparison.OrdinalIgnoreCase)
                    && x.HareketTuru == "TAHSİLAT"
                    && x.Havale > 0)
        .OrderBy(x => x.Tarih)
        .ToList();

    var etilAlkol = etilAlkolHam
        .Where(x => string.IsNullOrWhiteSpace(_eTarih)
                    || x.Tarih.ToString("dd.MM.yyyy").Contains(_eTarih.Trim())
                    || x.Tarih.ToString("yyyy-MM-dd").Contains(_eTarih.Trim()))
        .Where(x => MetinEslesir(x.ChKod, _eChKod))
        .Where(x => MetinEslesir(x.ChUnvani, _eChUnvan))
        .Where(x => MetinEslesir(x.BankaHesapKodu, _eBankaKod))
        .Where(x => MetinEslesir(x.BankaHesapAciklamasi, _eBankaAcik))
        .Where(x => MetinEslesir(x.ProjeKodu, _eProjeKod))
        .Where(x => MetinEslesir(x.IslemNo, _eIslemNo))
        .Where(x => MetinEslesir(x.FisTuru, _eFisTuru))
        .Where(x => SayiEslesir(x.Havale, _eHavale))
        .ToList();
    var etilToplam = etilAlkol.Sum(x => x.Havale);

    // Genel Merkez view'inden sadece Havale (Gelen Havaleler) — bu kayıtlar
    // INF_MD_FINANS_PROJE_RAPORU_211_YYYY view'üne Genel Merkez'in girdiği fişlerden gelir.
    var view120_04Havale = _ham
        .Where(x => (x.ChKod ?? "").StartsWith("120.04", StringComparison.OrdinalIgnoreCase)
                    && x.HareketTuru == "TAHSİLAT"
                    && x.Havale > 0)
        .ToList();

    // Lokal Cari Hesap Hareketleri'nden gelen Nakit Tahsilat + Kredi Kartı (CLFLINE).
    // Bunlar Genel Merkez view'üne düşmediği için tablo eksik kalmasın diye ayrı çekiliyor.
    var kkHam = view120_04Havale
        .Concat(_yerel120_04)
        .OrderBy(x => x.Tarih)
        .ToList();

    var kk = kkHam
        .Where(x => string.IsNullOrWhiteSpace(_kkTarih)
                    || x.Tarih.ToString("dd.MM.yyyy").Contains(_kkTarih.Trim())
                    || x.Tarih.ToString("yyyy-MM-dd").Contains(_kkTarih.Trim()))
        .Where(x => MetinEslesir(x.ChKod, _kkChKod))
        .Where(x => MetinEslesir(x.ChUnvani, _kkChUnvan))
        .Where(x => MetinEslesir(x.Modul, _kkModul))
        .Where(x => MetinEslesir(x.BankaHesapKodu, _kkBankaKod))
        .Where(x => MetinEslesir(x.BankaHesapAciklamasi, _kkBankaAcik))
        .Where(x => MetinEslesir(x.ProjeKodu, _kkProjeKod))
        .Where(x => MetinEslesir(x.IslemNo, _kkIslemNo))
        .Where(x => MetinEslesir(x.FisTuru, _kkFisTuru))
        .Where(x => SayiEslesir(x.Havale + x.Cek + x.Devir + x.Diger, _kkTutar))
        .ToList();
    var kkToplam = kk.Sum(x => x.Havale + x.Cek + x.Devir + x.Diger);

    <MudExpansionPanels Class="mb-3" MultiExpansion="true">
        <MudExpansionPanel IsInitiallyExpanded="true">
            <TitleContent>
                <div class="d-flex align-center" style="width:100%; gap:12px;">
                    <MudIcon Icon="@Icons.Material.Filled.LocalBar" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle1"><b>Etil Alkol Carileri — Gelen Bedeller</b> (CH 120.99.10.* / Havale)</MudText>
                    <MudSpacer />
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@etilAlkol.Count / @etilAlkolHam.Count satır</MudChip>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">Toplam: @etilToplam.ToString("N2") ₺</MudChip>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="EtilAlkolExcelIndir"
                               OnClickStopPropagation="true"
                               Disabled="@(etilAlkol.Count == 0)">
                        Excel
                    </MudButton>
                </div>
            </TitleContent>
            <ChildContent>
                @if (etilAlkolHam.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Seçili tarih aralığında 120.99.10.* cari kodlu firmalardan gelen havale bulunamadı.
                    </MudAlert>
                }
                else
                {
                    <div style="overflow:auto; max-height:340px;">
                        <table class="finans-table">
                            <thead>
                                <tr class="baslik-row">
                                    <th>Tarih</th>
                                    <th>CH Kodu</th>
                                    <th>CH Ünvanı</th>
                                    <th>Banka Kodu</th>
                                    <th>Banka Açıklaması</th>
                                    <th>Proje Kodu</th>
                                    <th>İşlem No</th>
                                    <th>Fiş Türü</th>
                                    <th class="num">Havale (₺)</th>
                                </tr>
                                <tr class="filtre-row">
                                    <th><input type="text" @bind="_eTarih" @bind:event="oninput" placeholder="örn. 2026-03" /></th>
                                    <th><input type="text" @bind="_eChKod" @bind:event="oninput" placeholder="120.99.10..." /></th>
                                    <th><input type="text" @bind="_eChUnvan" @bind:event="oninput" placeholder="ünvan..." /></th>
                                    <th><input type="text" @bind="_eBankaKod" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_eBankaAcik" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_eProjeKod" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_eIslemNo" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_eFisTuru" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_eHavale" @bind:event="oninput" placeholder=">=100 &lt;=500" /></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var x in etilAlkol)
                                {
                                    var row = x;
                                    <tr class="finans-row" title="Detay için çift tıklayın"
                                        @ondblclick="@(() => FisDetayAc(row))">
                                        <td>@x.Tarih.ToString("dd.MM.yyyy")</td>
                                        <td>@x.ChKod</td>
                                        <td>@x.ChUnvani</td>
                                        <td>@x.BankaHesapKodu</td>
                                        <td>@x.BankaHesapAciklamasi</td>
                                        <td>@x.ProjeKodu</td>
                                        <td>@x.IslemNo</td>
                                        <td>@x.FisTuru</td>
                                        <td class="num">@x.Havale.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="toplam-row">
                                    <td colspan="8">TOPLAM (@etilAlkol.Count satır)</td>
                                    <td class="num">@etilToplam.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel IsInitiallyExpanded="true">
            <TitleContent>
                <div class="d-flex align-center" style="width:100%; gap:12px;">
                    <MudIcon Icon="@Icons.Material.Filled.CreditCard" Color="Color.Tertiary" />
                    <MudText Typo="Typo.subtitle1"><b>120.04 Carileri — Tahsilatlar</b> (Havale + Kredi Kartı + diğer)</MudText>
                    <MudSpacer />
                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@kk.Count / @kkHam.Count satır</MudChip>
                    <MudChip T="string" Color="Color.Info" Size="Size.Small">Toplam: @kkToplam.ToString("N2") ₺</MudChip>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.FileDownload"
                               OnClick="Cari120_04ExcelIndir"
                               OnClickStopPropagation="true"
                               Disabled="@(kk.Count == 0)">
                        Excel
                    </MudButton>
                </div>
            </TitleContent>
            <ChildContent>
                @if (kkHam.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Seçili tarih aralığında 120.04.* cari kodlu firmalardan tahsilat bulunamadı.
                    </MudAlert>
                }
                else
                {
                    <div style="overflow:auto; max-height:340px;">
                        <table class="finans-table">
                            <thead>
                                <tr class="baslik-row">
                                    <th>Tarih</th>
                                    <th>CH Kodu</th>
                                    <th>CH Ünvanı</th>
                                    <th>Modül</th>
                                    <th>Banka Kodu</th>
                                    <th>Banka Açıklaması</th>
                                    <th>Proje Kodu</th>
                                    <th>İşlem No</th>
                                    <th>Fiş Türü</th>
                                    <th class="num">Tutar (₺)</th>
                                </tr>
                                <tr class="filtre-row">
                                    <th><input type="text" @bind="_kkTarih" @bind:event="oninput" placeholder="örn. 2026-03" /></th>
                                    <th><input type="text" @bind="_kkChKod" @bind:event="oninput" placeholder="120.04..." /></th>
                                    <th><input type="text" @bind="_kkChUnvan" @bind:event="oninput" placeholder="ünvan..." /></th>
                                    <th><input type="text" @bind="_kkModul" @bind:event="oninput" placeholder="BANKA / KK..." /></th>
                                    <th><input type="text" @bind="_kkBankaKod" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_kkBankaAcik" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_kkProjeKod" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_kkIslemNo" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_kkFisTuru" @bind:event="oninput" placeholder="filtre..." /></th>
                                    <th><input type="text" @bind="_kkTutar" @bind:event="oninput" placeholder=">=100 &lt;=500" /></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var x in kk)
                                {
                                    var row = x;
                                    var tutar = x.Havale + x.Cek + x.Devir + x.Diger;
                                    <tr class="finans-row" title="Detay için çift tıklayın"
                                        @ondblclick="@(() => FisDetayAc(row))">
                                        <td>@x.Tarih.ToString("dd.MM.yyyy")</td>
                                        <td>@x.ChKod</td>
                                        <td>@x.ChUnvani</td>
                                        <td>@x.Modul</td>
                                        <td>@x.BankaHesapKodu</td>
                                        <td>@x.BankaHesapAciklamasi</td>
                                        <td>@x.ProjeKodu</td>
                                        <td>@x.IslemNo</td>
                                        <td>@x.FisTuru</td>
                                        <td class="num">@tutar.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="toplam-row">
                                    <td colspan="9">TOPLAM (@kk.Count satır)</td>
                                    <td class="num">@kkToplam.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudPaper Class="pa-2">
        <div style="overflow:auto; max-height:620px;">
            <table class="finans-table">
                <thead>
                    <tr class="baslik-row">
                        <th>Tarih</th>
                        <th>Yıl</th>
                        <th>Ay</th>
                        <th>Gün</th>
                        <th>Hareket</th>
                        <th>Modül</th>
                        <th>Fiş Türü</th>
                        <th>CH Kodu</th>
                        <th>CH Ünvanı</th>
                        <th>Banka Kodu</th>
                        <th>Banka Açıklaması</th>
                        <th>Proje Kodu</th>
                        <th>Proje Adı</th>
                        <th>Özel Kod</th>
                        <th>İşlem No</th>
                        <th class="num">Havale</th>
                        <th class="num">Çek</th>
                        <th class="num">Devir</th>
                        <th class="num">Diğer</th>
                        <th>Sign</th>
                        <th>SpecOde</th>
                    </tr>
                    <tr class="filtre-row">
                        <th><input type="text" @bind="_fTarih" @bind:event="oninput" placeholder="örn. 2026-03" /></th>
                        <th><input type="text" @bind="_fYil" @bind:event="oninput" placeholder="..." /></th>
                        <th><input type="text" @bind="_fAy" @bind:event="oninput" placeholder="..." /></th>
                        <th><input type="text" @bind="_fGun" @bind:event="oninput" placeholder="..." /></th>
                        <th><input type="text" @bind="_fHareket" @bind:event="oninput" placeholder="TAHSİLAT..." /></th>
                        <th><input type="text" @bind="_fModul" @bind:event="oninput" placeholder="BANKA..." /></th>
                        <th><input type="text" @bind="_fFisTuru" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fChKod" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fChUnvan" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fBankaKod" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fBankaAcik" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fProjeKod" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fProjeAd" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fOzelKod" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fIslemNo" @bind:event="oninput" placeholder="filtre..." /></th>
                        <th><input type="text" @bind="_fHavale" @bind:event="oninput" placeholder=">=100 &lt;=500" /></th>
                        <th><input type="text" @bind="_fCek" @bind:event="oninput" placeholder=">=..." /></th>
                        <th><input type="text" @bind="_fDevir" @bind:event="oninput" placeholder=">=..." /></th>
                        <th><input type="text" @bind="_fDiger" @bind:event="oninput" placeholder=">=..." /></th>
                        <th><input type="text" @bind="_fSign" @bind:event="oninput" placeholder="..." /></th>
                        <th><input type="text" @bind="_fSpecOde" @bind:event="oninput" placeholder="..." /></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in filtreli)
                    {
                        var row = x;
                        <tr class="finans-row" title="Detay için çift tıklayın"
                            @ondblclick="@(() => FisDetayAc(row))">
                            <td>@x.Tarih.ToString("dd.MM.yyyy")</td>
                            <td>@x.Yil</td>
                            <td>@x.Ay</td>
                            <td>@x.Gun</td>
                            <td>
                                @if (x.HareketTuru == "TAHSİLAT")
                                {
                                    <span class="chip chip-tahsilat">TAHSİLAT</span>
                                }
                                else if (x.HareketTuru == "ÖDEME")
                                {
                                    <span class="chip chip-odeme">ÖDEME</span>
                                }
                                else
                                {
                                    @x.HareketTuru
                                }
                            </td>
                            <td>@x.Modul</td>
                            <td>@x.FisTuru</td>
                            <td>@x.ChKod</td>
                            <td>@x.ChUnvani</td>
                            <td>@x.BankaHesapKodu</td>
                            <td>@x.BankaHesapAciklamasi</td>
                            <td>@x.ProjeKodu</td>
                            <td>@x.ProjeAdi</td>
                            <td>@x.HaraketOzelKodu</td>
                            <td>@x.IslemNo</td>
                            <td class="num">@(x.Havale != 0 ? x.Havale.ToString("N2") : "")</td>
                            <td class="num">@(x.Cek    != 0 ? x.Cek.ToString("N2")    : "")</td>
                            <td class="num">@(x.Devir  != 0 ? x.Devir.ToString("N2")  : "")</td>
                            <td class="num">@(x.Diger  != 0 ? x.Diger.ToString("N2")  : "")</td>
                            <td>@x.Sign</td>
                            <td>@x.SpecOde</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="toplam-row">
                        <td colspan="15">TOPLAM (@filtreli.Count satır)</td>
                        <td class="num">@tHavale.ToString("N2")</td>
                        <td class="num">@tCek.ToString("N2")</td>
                        <td class="num">@tDevir.ToString("N2")</td>
                        <td class="num">@tDiger.ToString("N2")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </MudPaper>
}
else if (!_yukleniyor)
{
