    private async Task SesliAksiyonCalistir(VoiceIntent intent)
    {
        try
        {
            switch (intent.Action)
            {
                case "tarih_ayarla":
                {
                    var (b, t) = VoiceDateHelper.ParseBaslangicBitis(intent.Params, _baslangic, _bitis);
                    _baslangic = b; _bitis = t;
                    Snackbar.Add($"Tarih: {b:dd.MM.yyyy} - {t:dd.MM.yyyy}", Severity.Success);
                    break;
                }
                case "tarih_kisayol":
                {
                    var (b, t) = VoiceDateHelper.AraligiCevir(intent.Params.GetValueOrDefault("aralik") as string);
                    if (b == null) { Snackbar.Add("Aralık anlaşılamadı.", Severity.Warning); return; }
                    _baslangic = b; _bitis = t;
                    Snackbar.Add($"Tarih: {b:dd.MM.yyyy} - {t:dd.MM.yyyy}", Severity.Success);
                    await RaporGetir();
                    break;
                }
                case "sorgula":
                case "rapor_getir":
                case "yenile":
                    await RaporGetir();
                    break;
                case "filtreleri_temizle":
                    FiltreleriTemizle();
                    Snackbar.Add("Filtreler temizlendi.", Severity.Info);
                    break;
                default:
                    Snackbar.Add($"Bilinmeyen aksiyon: {intent.Action}", Severity.Warning);
                    break;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Aksiyon hatası: {ex.Message}", Severity.Error);
        }
    }

    private void YilSec(int yil)
    {
        _baslangic = new DateTime(yil, 1, 1);
        _bitis     = new DateTime(yil, 12, 31);
    }

    private void HizliSec(string tip)
    {
        var bugun = DateTime.Today;
        switch (tip)
        {
            case "bu-ay":
                _baslangic = new DateTime(bugun.Year, bugun.Month, 1);
                _bitis     = bugun;
                break;
            case "gecen-ay":
                var ga = bugun.AddMonths(-1);
                _baslangic = new DateTime(ga.Year, ga.Month, 1);
                _bitis     = new DateTime(ga.Year, ga.Month, DateTime.DaysInMonth(ga.Year, ga.Month));
                break;
            case "yil-basindan":
                _baslangic = new DateTime(bugun.Year, 1, 1);
                _bitis     = bugun;
                break;
            case "tumu":
                _baslangic = new DateTime(2025, 1, 1);
                _bitis     = bugun;
                break;
        }
    }

    private async Task RaporGetir()
    {
        if (_baslangic == null || _bitis == null)
        { Snackbar.Add("Tarih aralığı seçin.", Severity.Warning); return; }
        if (_bitis < _baslangic)
        { Snackbar.Add("Bitiş tarihi başlangıçtan küçük olamaz.", Severity.Warning); return; }

        _yukleniyor = true; _hata = null;
        try
        {
            DonemSiniri.Kirp(ref _bitis);
            _ham = await FinansService.GetHareketlerAsync(_baslangic.Value, _bitis.Value);
            _mevcutModuller = _ham.Select(x => x.Modul).Where(x => !string.IsNullOrEmpty(x))
                                  .Distinct().OrderBy(x => x).ToList();

            // 120.04 carileri için Genel Merkez view'üne düşmeyen local Nakit + Kredi Kartı
            // tahsilatlarını CLFLINE'dan ayrı çek. TRCODE 1 = Nakit Tahsilat, TRCODE 70 = Kredi
            // Kartı Fişi. TRCODE 20 (Gelen Havaleler) zaten view'den geliyor — burada çekersek
            // çift sayım olur.
            try
            {
                _yerel120_04 = await Logo.CariYerelTahsilatlarAsync(
                    _baslangic.Value, _bitis.Value, "120.04", new[] { 1, 70 });
            }
            catch (Exception lex)
            {
                _yerel120_04 = new();
                Snackbar.Add("Yerel Nakit/KK tahsilat sorgusu başarısız: " + lex.Message, Severity.Warning);
            }

            Snackbar.Add($"{_ham.Count} merkez + {_yerel120_04.Count} yerel satır yüklendi.", Severity.Success);
        }
        catch (Exception ex)
        {
            _hata = ex.Message;
            Snackbar.Add("Hata: " + ex.Message, Severity.Error);
        }
        finally { _yukleniyor = false; }
    }

