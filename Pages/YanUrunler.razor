@page "/yan-urunler"
@using RaporlamaPortali.Models
@using RaporlamaPortali.Services

@inject YanUrunlerService YanUrunlerService
@inject SekerSatisService SekerSatisService
@inject ExcelExportService ExcelExportService
@inject ZamanliMailService MailService
@inject IServiceProvider Services
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject VoiceContextService VoiceCtx

<PageTitle>Yan Ürünler Raporu</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Inventory" Class="mr-2" />
    Yan Ürünler Satış Raporu
</MudText>

@* Tarih Filtresi *@
<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="Başlangıç Tarihi" @bind-Date="_baslangicTarihi" 
                           DateFormat="dd.MM.yyyy" Editable="true" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3">
            <MudDatePicker Label="Bitiş Tarihi" @bind-Date="_bitisTarihi" 
                           DateFormat="dd.MM.yyyy" Editable="true" />
        </MudItem>
        <MudItem xs="12" sm="4" md="3" Class="d-flex align-end">
            <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled">
                <MudButton OnClick="RaporuGetir" Disabled="@_yukleniyor">
                    @if (_yukleniyor)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    }
                    <MudIcon Icon="@Icons.Material.Filled.Search" Class="mr-1" />
                    Rapor Getir
                </MudButton>
                <MudButton OnClick="ExcelIndir" Disabled="@(_yukleniyor || _yanUrunler == null)">
                    <MudIcon Icon="@Icons.Material.Filled.Download" Class="mr-1" />
                    Excel
                </MudButton>
                <MudButton OnClick="MailGonderAsync" Disabled="@_mailGonderiliyor"
                           Style="background:#1B5E20; color:#fff;">
                    @if (_mailGonderiliyor)
                    {
                        <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-1" />
                    }
                    Mail Gönder
                </MudButton>
            </MudButtonGroup>
        </MudItem>
        @if (!string.IsNullOrEmpty(_mailSonucu))
        {
            <MudItem xs="12">
                <MudAlert Severity="@(_mailBasarili ? Severity.Success : Severity.Error)" Dense="true">
                    @_mailSonucu
                </MudAlert>
            </MudItem>
        }
        <MudItem xs="12" sm="12" md="3" Class="d-flex align-end justify-end">
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton OnClick="@(() => SetTarihAraligi(0))">Bu Ay</MudButton>
                <MudButton OnClick="@(() => SetTarihAraligi(1))">Bu Yıl</MudButton>
                <MudButton OnClick="@(() => SetTarihAraligi(2))">Geçen Ay</MudButton>
            </MudButtonGroup>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_hata != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@_hata</MudAlert>
}

@if (_yanUrunler != null)
{
    @* YAN ÜRÜNLER TABLOSU *@
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Grass" Class="mr-2" />
            Yan Ürünler (Melas, Küspe) - <small>Birim: TON</small>
        </MudText>
        
        <MudSimpleTable Hover="true" Striped="true" Dense="true" Style="font-size: 0.85rem;" Bordered="true">
            <thead>
                <tr style="background-color: #E8F5E9;">
                    <th style="border: 1px solid #ccc;">Malzeme</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Devir Stok</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Üretim</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Satın Alma</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Satış</th>
                    <th style="text-align: right; border: 1px solid #ccc;">İade</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Tüketim</th>
                    <th style="text-align: right; background-color: #C8E6C9; border: 1px solid #ccc;"><strong>STOK</strong></th>
                    <th style="text-align: right; border: 1px solid #ccc;">Satış Tutarı (TL)</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Ort. Fiyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kategori in new[] { "MELAS", "YAS_KUSPE", "KURU_KUSPE", "DIGER" })
                {
                    var kategoridekiler = _yanUrunler.Where(x => x.Kategori == kategori).ToList();
                    if (!kategoridekiler.Any()) continue;
                    
                    @foreach (var urun in kategoridekiler)
                    {
                        <tr>
                            <td style="border: 1px solid #ddd;">@urun.MalzemeAdi</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@urun.DevirStokTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@urun.UretimTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@urun.SatinAlmaTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@urun.SatisTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@urun.IadeTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@urun.TuketimTon.ToString("N2")</td>
                            <td style="text-align: right; background-color: #E8F5E9; border: 1px solid #ddd;"><strong>@urun.StokTon.ToString("N2")</strong></td>
                            <td style="text-align: right; border: 1px solid #ddd;">@urun.SatisTutari.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@urun.OrtalamaFiyat.ToString("N2")</td>
                        </tr>
                    }
                    
                    @if (kategori == "YAS_KUSPE" || kategori == "KURU_KUSPE")
                    {
                        var toplam = YanUrunlerService.HesaplaKategoriToplam(_yanUrunler, kategori);
                        var bgColor = kategori == "YAS_KUSPE" ? "#90EE90" : "#FFDAB9";
                        <tr style="background-color: @bgColor; font-weight: bold;">
                            <td style="border: 1px solid #ddd;">@toplam.MalzemeAdi</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.DevirStokTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.UretimTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.SatinAlmaTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.SatisTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.IadeTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.TuketimTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.StokTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.SatisTutari.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@toplam.OrtalamaFiyat.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @* ALKOL TABLOSU *@
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Science" Class="mr-2" />
            Etil Alkol Satış Raporu - <small>Birim: TON (Lt/1000)</small>
        </MudText>
        
        <MudSimpleTable Hover="true" Striped="true" Dense="true" Style="font-size: 0.85rem;" Bordered="true">
            <thead>
                <tr style="background-color: #E3F2FD;">
                    <th style="border: 1px solid #ccc;">Alkol Türü</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Devir Stok</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Üretim</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Satın Alma</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Satış</th>
                    <th style="text-align: right; border: 1px solid #ccc;">İade</th>
                    <th style="text-align: right; background-color: #BBDEFB; border: 1px solid #ccc;"><strong>STOK</strong></th>
                    <th style="text-align: right; border: 1px solid #ccc;">Satış Tutarı (TL)</th>
                    <th style="text-align: right; border: 1px solid #ccc;">Ort. Fiyat</th>
                </tr>
            </thead>
            <tbody>
                @if (_alkoller != null)
                {
                    @foreach (var alkol in _alkoller)
                    {
                        <tr>
                            <td style="border: 1px solid #ddd;">@alkol.MalzemeAdi</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@alkol.DevirStokTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@alkol.UretimTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@alkol.SatinAlmaTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@alkol.SatisTon.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@alkol.IadeTon.ToString("N2")</td>
                            <td style="text-align: right; background-color: #E3F2FD; border: 1px solid #ddd;"><strong>@alkol.StokTon.ToString("N2")</strong></td>
                            <td style="text-align: right; border: 1px solid #ddd;">@alkol.SatisTutari.ToString("N2")</td>
                            <td style="text-align: right; border: 1px solid #ddd;">@alkol.OrtalamaFiyat.ToString("N2")</td>
                        </tr>
                    }
                    
                    @* Alkol Toplam *@
                    <tr style="background-color: #FFB6C1; font-weight: bold;">
                        <td style="border: 1px solid #ddd;">ALKOL TOPLAMI</td>
                        <td style="text-align: right; border: 1px solid #ddd;">@_alkoller.Sum(x => x.DevirStokTon).ToString("N2")</td>
                        <td style="text-align: right; border: 1px solid #ddd;">@_alkoller.Sum(x => x.UretimTon).ToString("N2")</td>
                        <td style="text-align: right; border: 1px solid #ddd;">@_alkoller.Sum(x => x.SatinAlmaTon).ToString("N2")</td>
                        <td style="text-align: right; border: 1px solid #ddd;">@_alkoller.Sum(x => x.SatisTon).ToString("N2")</td>
                        <td style="text-align: right; border: 1px solid #ddd;">@_alkoller.Sum(x => x.IadeTon).ToString("N2")</td>
                        <td style="text-align: right; border: 1px solid #ddd;">@_alkoller.Sum(x => x.StokTon).ToString("N2")</td>
                        <td style="text-align: right; border: 1px solid #ddd;">@_alkoller.Sum(x => x.SatisTutari).ToString("N2")</td>
                        <td style="text-align: right; border: 1px solid #ddd;">@(_alkoller.Sum(x => x.SatisMiktari) > 0 ? (_alkoller.Sum(x => x.SatisTutari) / _alkoller.Sum(x => x.SatisMiktari)).ToString("N2") : "0")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        
        @* Tüketilen Melas *@
        @{
            var melasTuketim = _yanUrunler?.FirstOrDefault(x => x.Kategori == "MELAS")?.TuketimTon ?? 0;
        }
        <MudAlert Severity="Severity.Info" Class="mt-4" Dense="true">
            <strong>Alkol Üretimi için Tüketilen Melas:</strong> @melasTuketim.ToString("N2") Ton
        </MudAlert>
    </MudPaper>

    @* ŞEKER ÜRETİM–SATIŞ–STOK TABLOSU (mail içeriği ile birebir) *@
    @if (_sekerler != null && _sekerler.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Factory" Class="mr-2" />
                Şeker Üretim – Satış – Stok Tablosu - <small>Birim: TON</small>
            </MudText>

            <MudSimpleTable Hover="true" Striped="true" Dense="true" Style="font-size: 0.85rem;" Bordered="true">
                <thead>
                    <tr style="background-color:#E3F2FD;">
                        <th style="border: 1px solid #ccc;">Kategori</th>
                        <th style="text-align: right; border: 1px solid #ccc;">Devir</th>
                        <th style="text-align: right; border: 1px solid #ccc;">Üretim</th>
                        <th style="text-align: right; border: 1px solid #ccc;">S. Alma</th>
                        <th style="text-align: right; border: 1px solid #ccc;">S. İade</th>
                        <th style="text-align: right; border: 1px solid #ccc;">SA. İade</th>
                        <th style="text-align: right; border: 1px solid #ccc;">Satış</th>
                        <th style="text-align: right; border: 1px solid #ccc;">Promo</th>
                        <th style="text-align: right; border: 1px solid #ccc;">Sarf</th>
                        <th style="text-align: right; background-color:#BBDEFB; border: 1px solid #ccc;"><strong>STOK</strong></th>
                        <th style="text-align: right; border: 1px solid #ccc;">Satış Tutarı (TL)</th>
                        <th style="text-align: right; border: 1px solid #ccc;">Ort. Fiyat (TL/Kg)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _sekerler)
                    {
                        var stokRenk = s.StokTon < 0 ? "color:#c62828;font-weight:600;" : "";
                        <tr>
                            <td style="border:1px solid #ddd;">@s.KategoriAdi</td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.DevirStokTon.ToString("N2")</td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.UretimTon.ToString("N2")</td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.SatinAlmaTon.ToString("N2")</td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.IadeTon.ToString("N2")</td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.SatinAlmaIadeTon.ToString("N2")</td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.SatisTon.ToString("N2")</td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.PromosyonTon.ToString("N2")</td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.SarfTon.ToString("N2")</td>
                            <td style="text-align:right;background-color:#E3F2FD;border:1px solid #ddd;@stokRenk"><strong>@s.StokTon.ToString("N2")</strong></td>
                            <td style="text-align:right;border:1px solid #ddd;">@s.SatisTutari.ToString("N2")</td>
                            <td style="text-align:right;border:1px solid #ddd;">@(s.OrtalamaFiyat > 0 ? s.OrtalamaFiyat.ToString("N2") : "-")</td>
                        </tr>
                    }
                    @{
                        var topSatisMiktar = _sekerler.Sum(x => x.SatisMiktari);
                        var topSatisTutar  = _sekerler.Sum(x => x.SatisTutari);
                        var ortFiyatTop    = topSatisMiktar > 0 ? topSatisTutar / topSatisMiktar : 0m;
                    }
                    <tr style="background-color:#FFF59D;font-weight:bold;">
                        <td style="border:1px solid #ddd;">TOPLAM</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.DevirStokTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.UretimTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.SatinAlmaTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.IadeTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.SatinAlmaIadeTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.SatisTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.PromosyonTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.SarfTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@_sekerler.Sum(x => x.StokTon).ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@topSatisTutar.ToString("N2")</td>
                        <td style="text-align:right;border:1px solid #ddd;">@(ortFiyatTop > 0 ? ortFiyatTop.ToString("N2") : "-")</td>
                    </tr>
                </tbody>
            </MudSimpleTable>

            <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                <strong>Hesaplama:</strong> Stok = Devir + Üretim + S.Alma + S.İade − SA.İade − Satış − Promo − Sarf
                &nbsp;|&nbsp; Devir başlangıcı: 01.09.2025 (kampanya başı)
            </MudAlert>
        </MudPaper>
    }
}
else if (!_yukleniyor)
{
    <MudAlert Severity="Severity.Info">
        Rapor görüntülemek için tarih aralığı seçip "Rapor Getir" butonuna tıklayın.
    </MudAlert>
}

@code {
    private DateTime? _baslangicTarihi = new DateTime(DateTime.Now.Year, 1, 1);
    private DateTime? _bitisTarihi = DateTime.Now;
    private bool _yukleniyor = false;
    private string? _hata = null;

    private List<YanUrunOzet>? _yanUrunler;
    private List<AlkolOzet>? _alkoller;
    private List<SekerSatisOzet>? _sekerler;

    // Mail
    private bool    _mailGonderiliyor = false;
    private bool    _mailBasarili     = false;
    private string? _mailSonucu;

    protected override void OnInitialized()    => RegisterVoice();

    protected override void OnAfterRender(bool firstRender)
    {
        // Backup: ServerPrerendered + circuit timing nedeniyle OnInitialized'deki
        // Register bazen VoiceCtx.Clear() sonrası gelirse boşa düşer. Tools boşsa tekrar Register et.
        if (VoiceCtx.Tools.Count == 0) RegisterVoice();
    }

    private void RegisterVoice() =>
        VoiceCtx.Register(_voiceTools, "Özet Rapor",
            getEkContext: VoiceContextOlustur,
            onayList: _voiceOnayAksiyonlar,
            onAksiyon: SesliAksiyonCalistir);

    private static readonly HashSet<string> _voiceOnayAksiyonlar = new() { "mail_gonder" };

    private string VoiceContextOlustur()
        => $"Mevcut tarih: {_baslangicTarihi:dd.MM.yyyy} - {_bitisTarihi:dd.MM.yyyy}";

    private List<SesliKomutTool> _voiceTools => new()
    {
        new SesliKomutTool { Ad = "rapor_getir",  Aciklama = "Raporu yeniler / getirir (Rapor Getir butonu)." },
        new SesliKomutTool { Ad = "sorgula",      Aciklama = "rapor_getir ile aynı — sorguyu çalıştırır." },
        new SesliKomutTool { Ad = "excel_indir",  Aciklama = "Excel olarak indirir." },
        new SesliKomutTool { Ad = "mail_gonder",  Aciklama = "Özet raporu mail olarak gönderir (Yan Ürünler + Şeker + Alkol)." },
        new SesliKomutTool
        {
            Ad = "tarih_ayarla",
            Aciklama = "Başlangıç ve/veya bitiş tarihini doğrudan ayarlar. ISO yyyy-MM-dd format. "
                     + "Eksik bırakılan kenar mevcut değerini korur. Tek başına çağrıldığında raporu OTOMATİK getirmez "
                     + "— komut_zinciri içinde sonra `rapor_getir` çağrılmalı.",
            Parametreler = new()
            {
                ["baslangic"] = new SesliKomutParam { Tip = "string", Aciklama = "Başlangıç tarihi (yyyy-MM-dd)." },
                ["bitis"]     = new SesliKomutParam { Tip = "string", Aciklama = "Bitiş tarihi (yyyy-MM-dd)." },
            }
        },
        new SesliKomutTool
        {
            Ad = "tarih_kisayol",
            Aciklama = "Hızlı tarih seçimi: 'bu ay' / 'bu yıl' / 'geçen ay' — ayarlar VE raporu getirir.",
            Parametreler = new()
            {
                ["aralik"] = new SesliKomutParam
                {
                    Tip = "string", Zorunlu = true,
                    Aciklama = "Hangi aralık.",
                    Secenekler = new() { "bu_ay", "bu_yil", "gecen_ay" },
                }
            }
        },
    };

    private async Task SesliAksiyonCalistir(VoiceIntent intent)
    {
        try
        {
            switch (intent.Action)
            {
                case "rapor_getir":
                case "sorgula":
                case "yenile":
                    await RaporuGetir();
                    break;
                case "excel_indir": await ExcelIndir(); break;
                case "mail_gonder": await MailGonderAsync(); break;
                case "tarih_ayarla":
                {
                    var (b, t) = VoiceDateHelper.ParseBaslangicBitis(intent.Params, _baslangicTarihi, _bitisTarihi);
                    _baslangicTarihi = b; _bitisTarihi = t;
                    Snackbar.Add($"Tarih: {b:dd.MM.yyyy} - {t:dd.MM.yyyy}", Severity.Success);
                    break;
                }
                case "tarih_araligi":
                {
                    var (b, t) = VoiceDateHelper.AraligiCevir(intent.Params.GetValueOrDefault("aralik") as string);
                    if (b == null) { Snackbar.Add("Aralık anlaşılamadı.", Severity.Warning); return; }
                    _baslangicTarihi = b; _bitisTarihi = t;
                    Snackbar.Add($"Tarih: {b:dd.MM.yyyy} - {t:dd.MM.yyyy}", Severity.Success);
                    break;
                }
                case "tarih_kisayol":
                {
                    var a = (intent.Params.GetValueOrDefault("aralik") as string ?? "").ToLower();
                    int tip = a switch { "bu_ay" => 0, "bu_yil" => 1, "gecen_ay" => 2, _ => -1 };
                    if (tip < 0) { Snackbar.Add("Aralık anlaşılamadı.", Severity.Warning); return; }
                    SetTarihAraligi(tip);
                    await RaporuGetir();
                    break;
                }
                default: Snackbar.Add($"Bilinmeyen aksiyon: {intent.Action}", Severity.Warning); break;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Aksiyon hatası: {ex.Message}", Severity.Error);
        }
    }

    private async Task MailGonderAsync()
    {
        _mailGonderiliyor = true;
        _mailSonucu = null;
        StateHasChanged();
        try
        {
            using var scope = Services.CreateScope();
            var sonuc = await MailService.OzetRaporManuelGonder(scope.ServiceProvider);
            _mailBasarili = sonuc;
            _mailSonucu = sonuc ? "Mail başarıyla gönderildi!" : "Mail gönderilemedi.";
        }
        catch (Exception ex)
        {
            _mailBasarili = false;
            _mailSonucu = "Hata: " + ex.Message;
        }
        _mailGonderiliyor = false;
        StateHasChanged();
        await Task.Delay(5000);
        _mailSonucu = null;
        StateHasChanged();
    }

    private async Task RaporuGetir()
    {
        if (_baslangicTarihi == null || _bitisTarihi == null)
        {
            Snackbar.Add("Lütfen tarih aralığı seçin!", Severity.Warning);
            return;
        }

        _yukleniyor = true;
        _hata = null;

        try
        {
            DonemSiniri.Kirp(ref _bitisTarihi);
            var baslangic = _baslangicTarihi.Value;
            var bitis = _bitisTarihi.Value;
            
            // Üç ana servisi paralel çağır (Şeker eklenince mail içeriğiyle birebir uyumlu olur)
            var tYan   = YanUrunlerService.GetYanUrunlerOzetAsync(baslangic, bitis);
            var tAlk   = YanUrunlerService.GetAlkolOzetAsync(baslangic, bitis);
            var tSeker = SekerSatisService.GetSekerSatisOzetAsync(baslangic, bitis);
            await Task.WhenAll(tYan, tAlk, tSeker);
            _yanUrunler = tYan.Result;
            _alkoller   = tAlk.Result;
            _sekerler   = tSeker.Result;

            Snackbar.Add("Rapor başarıyla yüklendi!", Severity.Success);
        }
        catch (Exception ex)
        {
            _hata = $"Rapor yüklenirken hata oluştu: {ex.Message}";
            Snackbar.Add(_hata, Severity.Error);
        }
        finally
        {
            _yukleniyor = false;
        }
    }

    private async Task ExcelIndir()
    {
        if (_yanUrunler == null || _alkoller == null) return;
        
        try
        {
            var melasTuketim = _yanUrunler.FirstOrDefault(x => x.Kategori == "MELAS")?.TuketimMiktari ?? 0;
            var excelBytes = ExcelExportService.ExportYanUrunlerRaporu(
                _yanUrunler,
                _alkoller,
                melasTuketim,
                _baslangicTarihi!.Value,
                _bitisTarihi!.Value,
                _sekerler);
            
            var fileName = $"YanUrunler_{_baslangicTarihi:yyyyMMdd}_{_bitisTarihi:yyyyMMdd}.xlsx";
            
            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(excelBytes), "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            
            Snackbar.Add("Excel dosyası indirildi!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Excel oluşturulurken hata: {ex.Message}", Severity.Error);
        }
    }

    private void SetTarihAraligi(int tip)
    {
        var today = DateTime.Today;
        
        switch (tip)
        {
            case 0: // Bu Ay
                _baslangicTarihi = new DateTime(today.Year, today.Month, 1);
                _bitisTarihi = today;
                break;
            case 1: // Bu Yıl
                _baslangicTarihi = new DateTime(today.Year, 1, 1);
                _bitisTarihi = today;
                break;
            case 2: // Geçen Ay
                var gecenAy = today.AddMonths(-1);
                _baslangicTarihi = new DateTime(gecenAy.Year, gecenAy.Month, 1);
                _bitisTarihi = new DateTime(gecenAy.Year, gecenAy.Month, DateTime.DaysInMonth(gecenAy.Year, gecenAy.Month));
                break;
        }
    }
}
