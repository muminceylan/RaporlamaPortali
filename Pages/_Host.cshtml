@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace RaporlamaPortali.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="~/" />
    <title>Raporlama Portali - Doğuş Çay</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />

    <!-- PWA: telefondan "Uygulamayı Yükle" ile ana ekrana eklenebilir -->
    <link rel="manifest" href="manifest.json" />
    <link rel="icon" type="image/png" sizes="32x32" href="images/favicon-32.png" />
    <link rel="apple-touch-icon" href="images/icon-192.png" />
    <meta name="theme-color" content="#1B5E20" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Raporlama" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Bir hata oluştu. Lütfen sayfayı yenileyin.
        </environment>
        <environment include="Development">
            An error has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Yenile</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/site.js?v=20260420b"></script>
    <script src="js/voice.js?v=20260608"></script>
    <script>
        // PWA: Service worker'i kaydet — ana ekrana ekleme ve cevrimdisi fallback icin
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/service-worker.js').catch(() => { });
            });
        }
    </script>
</body>
</html>
