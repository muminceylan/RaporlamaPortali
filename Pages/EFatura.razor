    .efatura-list-tbl .mud-table-cell { padding: 3px 8px !important; line-height: 1.15 !important; vertical-align: middle; font-size: 0.88em; }
    .efatura-list-tbl .mud-table-head .mud-table-cell { padding: 6px 8px !important; font-size: 0.82em; }
    .efatura-list-tbl .mud-table-cell .mud-icon-button { padding: 3px !important; min-width: 26px; height: 26px; width: 26px; }
    .efatura-list-tbl .mud-table-cell .mud-icon-button .mud-icon-root { font-size: 1rem; }
    .efatura-list-tbl .mud-chip-small { height: 20px; font-size: 0.72em; padding: 0 8px; }
    .efatura-list-tbl .ef-mini { color:#999; font-size:0.8em; margin-left:4px; }
    .efatura-list-tbl .ef-dash { color:#cfd8dc; }
