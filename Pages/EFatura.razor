    .totals-tbl td { padding:5px 8px; border-bottom:1px dashed #cfd8dc; }
    .totals-tbl td.num { text-align:right; font-variant-numeric:tabular-nums; font-weight:500; }
    .totals-tbl tr.payable td { background:#0d47a1; color:#fff; font-weight:700; font-size:1.05em; border-bottom:none; }
    .totals-tbl tr.payable td.num { color:#fff; }
    .cari-detay-badge { display:inline-block; margin-top:6px; padding:3px 8px; background:#fff3cd; border:1px solid #f6c243;
                        border-radius:3px; color:#7a5a00; font-family:'Consolas',monospace; font-size:0.78rem; }

