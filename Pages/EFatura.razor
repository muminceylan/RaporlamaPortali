@page "/efatura"
@using RaporlamaPortali.Models
@using RaporlamaPortali.Services
@using RaporlamaPortali.Services.Logo
@inject EFaturaService Svc
@inject ExcelExportService ExcelExportService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject VoiceContextService VoiceCtx

<PageTitle>e-Fatura Görüntüleme</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2 d-flex align-center">
    <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" Color="Color.Primary" />
    e-Fatura Görüntüleme
    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-3"
             Icon="@Icons.Material.Filled.Storage">eFaturaDogusCayDB</MudChip>
</MudText>

@if (!Svc.BaglantiTanimliMi)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
        EFaturaDB connection string tanımlı değil. appsettings.json içinden ConnectionStrings:EFaturaDB değerini ayarlayın.
    </MudAlert>
}


<MudPaper Class="pa-3 mb-3" Elevation="3" Style="border-left:4px solid #1976d2;">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="3">
            <MudToggleGroup T="EFaturaYon" SelectionMode="SelectionMode.SingleSelection"
                            @bind-Value="_filtre.Yon" Color="Color.Primary" CheckMark="true">
                <MudToggleItem Value="EFaturaYon.Gelen">
                    <MudIcon Icon="@Icons.Material.Filled.CallReceived" Class="mr-1" />
                    Gelen
                </MudToggleItem>
                <MudToggleItem Value="EFaturaYon.Giden">
                    <MudIcon Icon="@Icons.Material.Filled.CallMade" Class="mr-1" />
                    Giden
                </MudToggleItem>
            </MudToggleGroup>
        </MudItem>

        <MudItem xs="6" md="2">
            <MudDatePicker @bind-Date="_bas" Label="Başlangıç" DateFormat="dd.MM.yyyy"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           PickerVariant="PickerVariant.Dialog" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker @bind-Date="_bit" Label="Bitiş" DateFormat="dd.MM.yyyy"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           PickerVariant="PickerVariant.Dialog" />
        </MudItem>

        <MudItem xs="6" md="2">
            <MudSelect T="string" Label="Fatura Tipi" @bind-Value="_filtre.Tip"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true" Dense="true" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem T="string" Value="@(null)">— Hepsi —</MudSelectItem>
                @foreach (var t in _tipler)
                {
                    <MudSelectItem T="string" Value="@t">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="6" md="3" Class="d-flex align-center gap-2">
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="Sorgula" Disabled="_yukleniyor" FullWidth="true">
                @(_yukleniyor ? "Yükleniyor..." : "Sorgula")
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Title="Filtreleri temizle"
                           Color="Color.Default" OnClick="FiltreSifirla" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_filtre.KarsiUnvan"
                          Label="@(_filtre.Yon == EFaturaYon.Gelen ? "Gönderen Ünvan (LIKE)" : "Alıcı Ünvan (LIKE)")"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Business"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="_filtre.KarsiVKN" Label="VKN / TCKN"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Badge"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="_filtre.FaturaNo" Label="Fatura No (LIKE)"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Tag"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField @bind-Value="_filtre.LogoCariKodu"
                          Label="Logo Cari Kod (örn. 320.06)"
                          HelperText="Bu kodla başlayan cariler"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AccountTree"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudNumericField @bind-Value="_filtre.MaxKayit" Label="Max kayıt"
                             HelperText="Manuel yazabilirsiniz (50–5000)"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="50" Max="5000" Step="500" Immediate="true" />
        </MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudCheckBox T="bool" @bind-Value="_filtre.SistemYanitlariniGoster"
                         Color="Color.Warning" Dense="true"
                         Label="GİB sistem yanıtlarını da göster" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField @bind-Value="_filtre.FaturaNoListesiRaw"
                          Label="Fatura Numaraları (toplu filtre)"
                          HelperText="Birden fazla fatura numarası yapıştırın — yeni satır, virgül, noktalı virgül veya boşluk ile ayırın. Dolu ise sadece bu numaralardaki kayıtlar listelenir; boş ise tüm faturalar gelir."
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="4" Clearable="true"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ListAlt" />
            @{
                var _eFaturaListeSayisi = _filtre.FaturaNolariCoz().Length;
            }
            @if (_eFaturaListeSayisi > 0)
            {
                <MudText Typo="Typo.caption" Style="color:#1976d2; margin-top:4px; display:block;">
                    <b>@_eFaturaListeSayisi</b> fatura numarası filtrede aktif.
                </MudText>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_kayitlar.Count == 0 && !_yukleniyor)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-3">
        Kayıt yok. Filtreleri ayarlayıp "Sorgula" tuşuna basın.
    </MudAlert>
}
else
{
    <MudPaper Class="pa-2 mb-2 d-flex align-center" Elevation="0" Style="background:#e3f2fd;">
        <MudText Typo="Typo.body2">
            <b>@_kayitlar.Count</b> kayıt listelendi
            @if (_kayitlar.Count >= _filtre.MaxKayit)
            {
                <span style="color:#d32f2f"> (limit dolu — Max kayıt'ı artırın)</span>
            }
            &nbsp;|&nbsp; Tarih: <b>@(_bas?.ToString("dd.MM.yyyy"))</b> – <b>@(_bit?.ToString("dd.MM.yyyy"))</b>
        </MudText>
        <MudSpacer />
        <MudButton Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExcelIndir" Disabled="_excelYukleniyor || _kayitlar.Count == 0">
            @(_excelYukleniyor ? "Hazırlanıyor..." : $"Excel'e Aktar ({_kayitlar.Count})")
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="ml-2"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="LogoyaAktar" Disabled="@(_aktarimSayisi == 0)">
            Logo'ya Aktar (@_aktarimSayisi)
        </MudButton>
    </MudPaper>

    <MudTable T="EFaturaListItem" Items="_kayitlar" Dense="true" Hover="true" Bordered="true" Striped="true"
              FixedHeader="true" Height="calc(100vh - 420px)"
              Breakpoint="Breakpoint.None" RowsPerPage="100"
              Class="efatura-list-tbl">
        <HeaderContent>
            <MudTh Style="width:230px">Aktarım</MudTh>
            <MudTh Style="width:110px"><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.Tarih)">Tarih</MudTableSortLabel></MudTh>
            <MudTh Style="width:85px">Tip</MudTh>
            <MudTh Style="width:155px"><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.FaturaNo)">Fatura No</MudTableSortLabel></MudTh>
            <MudTh Style="width:110px">VKN/TCKN</MudTh>
            <MudTh Style="width:170px"><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.LogoCariKod)">Logo Cari</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.KarsiUnvan)">Karşı Taraf</MudTableSortLabel></MudTh>
            <MudTh Style="width:200px"><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.IlkKalem)">İlk Kalem</MudTableSortLabel></MudTh>
            <MudTh Style="width:95px;text-align:right"><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.Matrah)">Matrah</MudTableSortLabel></MudTh>
            <MudTh Style="width:85px;text-align:right"><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.KdvTutar)">KDV</MudTableSortLabel></MudTh>
            <MudTh Style="width:105px;text-align:right"><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.ToplamTutar)">Fatura Tutarı</MudTableSortLabel></MudTh>
            <MudTh Style="width:85px;text-align:right"><MudTableSortLabel SortBy="new Func<EFaturaListItem,object>(x=>x.TevkifatTutar)">Tevkifat</MudTableSortLabel></MudTh>
            <MudTh Style="width:140px;text-align:center">İşlem</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Aktarım" Style="white-space:nowrap; padding:2px 6px;">
                <div class="d-flex align-center gap-1">
                    <MudCheckBox T="bool"
                                 Value="@AktarimSecili(context.Id)"
                                 ValueChanged="@(v => AktarimToggle(context.Id, v))"
                                 Color="Color.Primary" Dense="true" Size="Size.Small" />
                    @if (AktarimSecili(context.Id))
                    {
                        var _tip = AktarimTipi(context.Id);
                        <MudButtonGroup OverrideStyles="false" Variant="Variant.Outlined" Size="Size.Small">
                            <MudButton Size="Size.Small"
                                       Variant="@(_tip == "AlinanHizmet" ? Variant.Filled : Variant.Outlined)"
                                       Color="@(_tip == "AlinanHizmet" ? Color.Success : Color.Default)"
                                       OnClick="@(() => AktarimTipiSec(context.Id, "AlinanHizmet"))"
                                       Style="text-transform:none; padding:2px 6px; min-width:auto; font-size:0.72rem;">
                                Alınan Hizmet
                            </MudButton>
                            <MudButton Size="Size.Small"
                                       Variant="@(_tip == "SatinAlma" ? Variant.Filled : Variant.Outlined)"
                                       Color="@(_tip == "SatinAlma" ? Color.Info : Color.Default)"
                                       OnClick="@(() => AktarimTipiSec(context.Id, "SatinAlma"))"
                                       Style="text-transform:none; padding:2px 6px; min-width:auto; font-size:0.72rem;">
                                Satın Alma
                            </MudButton>
                        </MudButtonGroup>
                    }
                </div>
            </MudTd>
            <MudTd DataLabel="Tarih" Style="white-space:nowrap;">
                <span>@context.Tarih.ToString("dd.MM.yyyy")</span>
                <span class="ef-mini">@context.Tarih.ToString("HH:mm")</span>
            </MudTd>
            <MudTd DataLabel="Tip">
                <MudChip T="string" Size="Size.Small" Color="@RenkTip(context.Tip)" Variant="Variant.Filled">
                    @context.Tip
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Fatura No" Style="font-family:'Consolas',monospace; font-size:0.85em;" Title="@context.Aciklama">
                @context.FaturaNo
            </MudTd>
            <MudTd DataLabel="VKN" Style="font-family:'Consolas',monospace; font-size:0.85em;">@context.KarsiVKN</MudTd>
            <MudTd DataLabel="Logo Cari">
                @if (!string.IsNullOrEmpty(context.LogoCariKod))
                {
                    <div class="ef-code">@context.LogoCariKod</div>
                    <div class="ef-sub" title="@context.LogoCariUnvan">@context.LogoCariUnvan</div>
                }
                else { <span class="ef-dash">—</span> }
            </MudTd>
            <MudTd DataLabel="Karşı Taraf" Class="ef-trunc" Title="@context.KarsiUnvan">@context.KarsiUnvan</MudTd>
            <MudTd DataLabel="İlk Kalem" Class="ef-trunc" Style="max-width:200px;" Title="@context.IlkKalem">@context.IlkKalem</MudTd>
            <MudTd DataLabel="Matrah" Class="ef-num">
                @if (context.Matrah != 0)
                {
                    @context.Matrah.ToString("N2")
                    @if (!string.IsNullOrEmpty(context.Doviz) && context.Doviz != "TRY")
                    { <span class="ef-mini"> @context.Doviz</span> }
                }
                else { <span class="ef-dash">—</span> }
            </MudTd>
            <MudTd DataLabel="KDV" Class="ef-num">
                @if (context.KdvTutar != 0)
                { @context.KdvTutar.ToString("N2") }
                else { <span class="ef-dash">—</span> }
            </MudTd>
            <MudTd DataLabel="Fatura Tutarı" Class="ef-num" Style="font-weight:600; color:#0d47a1;">
                @if (context.ToplamTutar != 0)
                { @context.ToplamTutar.ToString("N2") }
                else { <span class="ef-dash">—</span> }
            </MudTd>
            <MudTd DataLabel="Tevkifat" Class="ef-num" Style="color:#c62828;">
                @if (context.TevkifatTutar != 0)
                { @context.TevkifatTutar.ToString("N2") }
                else { <span class="ef-dash">—</span> }
            </MudTd>
            <MudTd DataLabel="İşlem" Style="text-align:center; white-space:nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Color="Color.Primary" Title="Detayı göster"
                               OnClick="@(() => DetayAc(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small"
                               Color="Color.Error" Title="PDF / Yazdır"
                               Href="@($"/efatura-pdf?id={context.Id}&vkn={Uri.EscapeDataString(context.KarsiVKN ?? "")}")"
                               Target="_blank" />
                <MudIconButton Icon="@Icons.Material.Filled.Code" Size="Size.Small"
                               Color="Color.Default" Title="XML'i indir"
                               Href="@($"/efatura-xml?id={context.Id}")" Target="_blank" />
                <MudIconButton Icon="@Icons.Material.Filled.Archive" Size="Size.Small"
                               Color="Color.Secondary" Title="ZIP'i indir"
                               Href="@($"/efatura-zip?id={context.Id}")" Target="_blank" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 50, 100, 250, 500 }" />
        </PagerContent>
        <NoRecordsContent>
            <MudText>Kayıt bulunamadı.</MudText>
        </NoRecordsContent>
    </MudTable>
}

<MudDrawer @bind-Open="_detayAcik" Anchor="Anchor.End" Variant="DrawerVariant.Temporary"
           Elevation="6" Width="min(96vw, 1280px)" Overlay="true">
    <MudDrawerHeader Style="background:linear-gradient(90deg,#0d47a1,#1976d2); color:white;">
        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
        <MudText Typo="Typo.h6">e-Fatura Detayı</MudText>
        <MudSpacer />
        @if (_detay != null)
        {
            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Inherit"
                           Title="PDF / Yazdır"
                           Href="@($"/efatura-pdf?id={_detay.Id}&vkn={Uri.EscapeDataString(_detayKarsiVkn)}")" Target="_blank" />
            <MudIconButton Icon="@Icons.Material.Filled.Code" Color="Color.Inherit"
                           Title="XML'i indir"
                           Href="@($"/efatura-xml?id={_detay.Id}")" Target="_blank" />
            <MudIconButton Icon="@Icons.Material.Filled.Archive" Color="Color.Inherit"
                           Title="ZIP'i indir"
                           Href="@($"/efatura-zip?id={_detay.Id}")" Target="_blank" />
        }
        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit"
                       OnClick="@(() => _detayAcik = false)" />
    </MudDrawerHeader>

    <div class="pa-3" style="overflow-y:auto; height:calc(100vh - 64px);">
        @if (_detayYukleniyor)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (_detay != null)
        {
            @* Üst başlık - taraflar + fatura künyesi *@
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Style="border-left:4px solid #2e7d32; height:100%;">
                        <MudCardContent>
                            <MudText Typo="Typo.overline" Color="Color.Success" Style="font-weight:700;">
                                <MudIcon Icon="@Icons.Material.Filled.Store" Class="mr-1" />
                                SATICI
                            </MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_detay.SaticiUnvan</MudText>
                            <MudText Typo="Typo.body2">VKN: <b>@_detay.SaticiVkn</b></MudText>
                            @if (!string.IsNullOrWhiteSpace(_detay.SaticiVergiDairesi))
                            {
                                <MudText Typo="Typo.body2">Vergi Dairesi: @_detay.SaticiVergiDairesi</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detay.SaticiAdres))
                            {
                                <MudText Typo="Typo.caption" Style="color:#666">@_detay.SaticiAdres</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detay.SaticiTelefon) || !string.IsNullOrWhiteSpace(_detay.SaticiEposta))
                            {
                                <MudText Typo="Typo.caption" Class="mt-1" Style="color:#666">
                                    @_detay.SaticiTelefon @(string.IsNullOrEmpty(_detay.SaticiEposta) ? "" : " · " + _detay.SaticiEposta)
                                </MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detay.LogoCariKod) && string.Equals(_detayKarsiVkn, _detay.SaticiVkn, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="cari-detay-badge" title="Logo Tiger LG_211_CLCARD eşleşmesi">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="font-size:14px;vertical-align:-2px" />
                                    Logo Cari: <b>@_detay.LogoCariKod</b>
                                    @if (!string.IsNullOrWhiteSpace(_detay.LogoCariUnvan))
                                    {
                                        <span style="opacity:.75">— @_detay.LogoCariUnvan</span>
                                    }
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Style="border-left:4px solid #1976d2; height:100%;">
                        <MudCardContent>
                            <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-1" />
                                ALICI
                            </MudText>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_detay.AliciUnvan</MudText>
                            <MudText Typo="Typo.body2">VKN: <b>@_detay.AliciVkn</b></MudText>
                            @if (!string.IsNullOrWhiteSpace(_detay.AliciVergiDairesi))
                            {
                                <MudText Typo="Typo.body2">Vergi Dairesi: @_detay.AliciVergiDairesi</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detay.AliciAdres))
                            {
                                <MudText Typo="Typo.caption" Style="color:#666">@_detay.AliciAdres</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(_detay.LogoCariKod) && string.Equals(_detayKarsiVkn, _detay.AliciVkn, StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="cari-detay-badge" title="Logo Tiger LG_211_CLCARD eşleşmesi">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="font-size:14px;vertical-align:-2px" />
                                    Logo Cari: <b>@_detay.LogoCariKod</b>
                                    @if (!string.IsNullOrWhiteSpace(_detay.LogoCariUnvan))
                                    {
                                        <span style="opacity:.75">— @_detay.LogoCariUnvan</span>
                                    }
                                </div>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12">
                    <MudPaper Class="pa-3" Style="background:#f5f5f5;">
                        <MudGrid Spacing="2">
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.overline" Style="color:#666">Fatura No</MudText>
                                <MudText Typo="Typo.h6" Style="font-family:'Consolas',monospace;">@_detay.FaturaNo</MudText>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudText Typo="Typo.overline" Style="color:#666">Tarih / Saat</MudText>
                                <MudText Typo="Typo.h6">@_detay.Tarih?.ToString("dd.MM.yyyy") <span style="font-size:0.7em;color:#888">@_detay.Saat</span></MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.overline" Style="color:#666">Fatura Tipi</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@RenkTip(_detay.Tip)" Variant="Variant.Filled">
                                    @_detay.Tip
                                </MudChip>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.overline" Style="color:#666">Senaryo</MudText>
                                <MudText Typo="Typo.body1">@_detay.ProfileId</MudText>
                            </MudItem>
                            <MudItem xs="6" md="2">
                                <MudText Typo="Typo.overline" Style="color:#666">Döviz</MudText>
                                <MudText Typo="Typo.h6">@_detay.Doviz @if (_detay.DovizKuru > 0) { <span style="font-size:0.6em;color:#888"> · kur @_detay.DovizKuru.ToString("N4")</span> }</MudText>
                            </MudItem>
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption" Style="color:#666">
                                    ETTN: <span style="font-family:'Consolas',monospace;">@_detay.Uuid</span>
                                </MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Kalemler tablosu *@
            <MudText Typo="Typo.h6" Class="mt-4 mb-2 d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" Color="Color.Primary" />
                Kalemler (@_detay.Kalemler.Count satır)
            </MudText>

            <MudTable T="EFaturaKalem" Items="_detay.Kalemler" Dense="true" Hover="true" Bordered="true" Striped="true"
                      Breakpoint="Breakpoint.None">
                <HeaderContent>
                    <MudTh Style="width:40px">#</MudTh>
                    <MudTh>Mal / Hizmet</MudTh>
                    <MudTh Style="width:120px">Stok Kodu</MudTh>
                    <MudTh Style="width:110px;text-align:right">Miktar</MudTh>
                    <MudTh Style="width:130px;text-align:right">Birim Fiyat</MudTh>
                    <MudTh Style="width:130px;text-align:right">Net Tutar</MudTh>
                    <MudTh Style="width:75px;text-align:center">KDV %</MudTh>
                    <MudTh Style="width:120px;text-align:right">KDV Tutar</MudTh>
                    <MudTh Style="width:75px;text-align:center">Tevkifat %</MudTh>
                    <MudTh Style="width:130px;text-align:right">Tevkifat Tutar</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Sira</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Style="font-weight:600;">@context.Aciklama</MudText>
                        @if (!string.IsNullOrWhiteSpace(context.StokAdi) && context.StokAdi != context.Aciklama)
                        {
                            <MudText Typo="Typo.caption" Style="color:#888">↳ @context.StokAdi</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(context.IstisnaKodu))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="mt-1">
                                İstisna: @context.IstisnaKodu @context.IstisnaSebep
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd Style="font-family:'Consolas',monospace; font-size:0.85em">@context.StokKodu</MudTd>
                    <MudTd Style="text-align:right">@context.Miktar.ToString("N2") <span style="color:#888;font-size:0.85em">@context.Birim</span></MudTd>
                    <MudTd Style="text-align:right">@context.BirimFiyat.ToString("N2") @context.Doviz</MudTd>
                    <MudTd Style="text-align:right;font-weight:600">@context.NetTutar.ToString("N2")</MudTd>
                    <MudTd Style="text-align:center">@(context.KdvOran == 0 ? "" : $"%{context.KdvOran:N0}")</MudTd>
                    <MudTd Style="text-align:right">@(context.KdvTutar == 0 ? "" : context.KdvTutar.ToString("N2"))</MudTd>
                    <MudTd Style="text-align:center">@(context.TevkifatOran == 0 ? "" : $"%{context.TevkifatOran:N0}")</MudTd>
                    <MudTd Style="text-align:right;color:#b71c1c;font-weight:600">@(context.TevkifatTutar == 0 ? "" : context.TevkifatTutar.ToString("N2"))</MudTd>
                </RowTemplate>
            </MudTable>

            @* Tevkifat kodları (alt-paneli) *@
            @if (_detay.Kalemler.Any(k => !string.IsNullOrWhiteSpace(k.TevkifatKodu)))
            {
                <MudPaper Class="pa-2 mt-2" Style="background:#fff3e0; border-left:4px solid #f57c00;">
                    <MudText Typo="Typo.subtitle2">
                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Class="mr-1" />
                        Tevkifat Kodları:
                    </MudText>
                    @foreach (var grp in _detay.Kalemler.Where(k => !string.IsNullOrWhiteSpace(k.TevkifatKodu))
                                  .GroupBy(k => new { k.TevkifatKodu, k.TevkifatAdi }))
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">
                            <b>@grp.Key.TevkifatKodu</b> — @grp.Key.TevkifatAdi
                        </MudText>
                    }
                </MudPaper>
            }

            <MudGrid Spacing="2" Class="mt-3">
                @* Sol: Açıklamalar *@
                <MudItem xs="12" md="6">
                    @if (_detay.FaturaNotlari.Count > 0)
                    {
                        <MudCard Elevation="2" Style="border-left:4px solid #6a1b9a; height:100%;">
                            <MudCardContent>
                                <MudText Typo="Typo.subtitle1" Class="mb-2" Color="Color.Secondary" Style="font-weight:700;">
                                    <MudIcon Icon="@Icons.Material.Filled.Notes" Class="mr-1" />
                                    Fatura Açıklamaları
                                </MudText>
                                @foreach (var n in _detay.FaturaNotlari)
                                {
                                    <MudText Typo="Typo.body2">• @n</MudText>
                                }
                            </MudCardContent>
                        </MudCard>
                    }
                </MudItem>

                @* Sağ: Toplamlar tablosu *@
                <MudItem xs="12" md="6">
                    <MudCard Elevation="3" Style="border:2px solid #1976d2; background:linear-gradient(135deg,#f8fbff,#e3f2fd);">
                        <MudCardContent>
                            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:700; color:#0d47a1">
                                <MudIcon Icon="@Icons.Material.Filled.Calculate" Class="mr-1" />
                                Mali Özet
                            </MudText>
                            <table class="totals-tbl">
                                <tr><td>Mal/Hizmet Toplamı</td><td class="num">@_detay.LineExtensionAmount.ToString("N2") @_detay.Doviz</td></tr>
                                @if (_detay.AllowanceTotalAmount > 0)
                                {
                                    <tr><td>Toplam İskonto</td><td class="num">@_detay.AllowanceTotalAmount.ToString("N2") @_detay.Doviz</td></tr>
                                }
                                @foreach (var v in _detay.VergiOzetleri)
                                {
                                    <tr>
                                        <td>@v.Adi @(v.Oran > 0 ? $"(%{v.Oran:N0})" : "")</td>
                                        <td class="num">@v.Tutar.ToString("N2") @_detay.Doviz</td>
                                    </tr>
                                }
                                @foreach (var t in _detay.TevkifatOzetleri)
                                {
                                    <tr style="color:#b71c1c">
                                        <td>↓ Tevkifat @(t.Oran > 0 ? $"(%{t.Oran:N0})" : "")</td>
                                        <td class="num">-@t.Tutar.ToString("N2") @_detay.Doviz</td>
                                    </tr>
                                }
                                <tr><td>Vergiler Dahil Toplam</td><td class="num">@_detay.TaxInclusiveAmount.ToString("N2") @_detay.Doviz</td></tr>
                                <tr class="payable"><td>ÖDENECEK TUTAR</td><td class="num">@_detay.PayableAmount.ToString("N2") @_detay.Doviz</td></tr>
                            </table>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            @* Vergi istisnaları (varsa) *@
            @if (_detay.VergiOzetleri.Any(v => !string.IsNullOrWhiteSpace(v.IstisnaKodu) || !string.IsNullOrWhiteSpace(v.IstisnaSebep)))
            {
                <MudPaper Class="pa-2 mt-2" Style="background:#fce4ec; border-left:4px solid #c2185b;">
                    <MudText Typo="Typo.subtitle2">
                        <MudIcon Icon="@Icons.Material.Filled.GppMaybe" Class="mr-1" />
                        KDV İstisna Açıklamaları:
                    </MudText>
                    @foreach (var v in _detay.VergiOzetleri.Where(x => !string.IsNullOrWhiteSpace(x.IstisnaKodu) || !string.IsNullOrWhiteSpace(x.IstisnaSebep)))
                    {
                        <MudText Typo="Typo.body2" Class="ml-3">
                            <b>@v.IstisnaKodu</b> — @v.IstisnaSebep
                        </MudText>
                    }
                </MudPaper>
            }
        }
        else
        {
            <MudAlert Severity="Severity.Warning">Detay yüklenemedi.</MudAlert>
        }
    </div>
</MudDrawer>

<style>
