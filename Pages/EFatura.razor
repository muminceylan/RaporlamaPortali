    .efatura-list-tbl .ef-trunc { max-width:280px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
</style>

@code {
    private EFaturaFiltre _filtre = new() { Yon = EFaturaYon.Gelen };
    private DateTime?     _bas    = DateTime.Today.AddDays(-30);
    private DateTime?     _bit    = DateTime.Today;
    private List<string>  _tipler = new();
    private List<EFaturaListItem> _kayitlar = new();
    private bool _yukleniyor = false;

    // Aktarım seçimleri: Id -> "AlinanHizmet" | "SatinAlma" | null
    // Checkbox işaretliyse Dictionary'de key vardır. Toggle ile eklenir/kaldırılır.
    private Dictionary<long, string?> _aktarimSecimleri = new();
    private bool AktarimSecili(long id) => _aktarimSecimleri.ContainsKey(id);
    private string? AktarimTipi(long id) => _aktarimSecimleri.TryGetValue(id, out var t) ? t : null;
    private void AktarimToggle(long id, bool secili)
    {
        if (secili) _aktarimSecimleri[id] = null;
        else        _aktarimSecimleri.Remove(id);
    }
    private void AktarimTipiSec(long id, string tip)
    {
        _aktarimSecimleri[id] = tip;
    }
    // "Logo'ya Aktar" butonu için aktif sayım — hem checkbox işaretli hem tip seçili olanlar
    private int _aktarimSayisi => _aktarimSecimleri.Count(kv => !string.IsNullOrEmpty(kv.Value));

    private async Task LogoyaAktar()
    {
        var secimler = _aktarimSecimleri
            .Where(kv => !string.IsNullOrEmpty(kv.Value))
            .Select(kv => (kv.Key, kv.Value == "AlinanHizmet" ? 4 : 1))
            .ToList();

        if (secimler.Count == 0)
        {
            Snackbar.Add("Hiç fatura seçilmedi (her seçilen faturanın tipini de işaretleyin).", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(SecretsService.LogoUnityKullanici) ||
            string.IsNullOrWhiteSpace(SecretsService.LogoUnitySifre))
        {
            Snackbar.Add("Logo Unity kullanıcı bilgileri ayarlanmamış — Sırlar sayfasından girin.", Severity.Error);
            return;
        }

        var cred = new LogoUnityCredentials
        {
            Kullanici = SecretsService.LogoUnityKullanici,
            Sifre     = SecretsService.LogoUnitySifre,
            FirmaNo   = 211,
        };

        var parameters = new DialogParameters
        {
            ["Secimler"] = (IReadOnlyList<(long, int)>)secimler,
            ["Cred"]     = cred,
        };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = false,
            FullWidth        = true,
            MaxWidth         = MaxWidth.ExtraExtraLarge,
            CloseButton      = false,
        };
        await DialogService.ShowAsync<EFaturaLogoAktarimDialog>("Logo'ya Aktar", parameters, options);
    }

    private bool          _detayAcik       = false;
    private bool          _detayYukleniyor = false;
    private EFaturaDetay? _detay;
    private string        _detayKarsiVkn   = "";
    private bool          _excelYukleniyor = false;

    protected override async Task OnInitializedAsync()
    {
        RegisterVoice();
        if (Svc.BaglantiTanimliMi)
        {
            try
            {
                _tipler = await Svc.InvoiceTiplerAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Bağlantı hatası: {ex.Message}", Severity.Error);
            }
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (VoiceCtx.Tools.Count == 0) RegisterVoice();
    }

    private void RegisterVoice() =>
        VoiceCtx.Register(_voiceTools, "e-Fatura Görüntüleme",
            getEkContext: VoiceContextOlustur,
            onAksiyon:    SesliAksiyonCalistir);

    private async Task Sorgula()
    {
        if (!Svc.BaglantiTanimliMi)
        {
            Snackbar.Add("EFaturaDB connection string tanımlı değil.", Severity.Error);
            return;
        }
        if (_bas == null || _bit == null)
        {
            Snackbar.Add("Tarih aralığı seçin.", Severity.Warning);
            return;
        }
        if (_bit < _bas)
        {
            Snackbar.Add("Bitiş tarihi başlangıçtan önce olamaz.", Severity.Warning);
            return;
        }

        _yukleniyor = true;
        try
        {
            DonemSiniri.Kirp(ref _bit);
            _filtre.Baslangic = _bas.Value;
            _filtre.Bitis     = _bit!.Value;
            _kayitlar = await Svc.ListeleAsync(_filtre);
            _aktarimSecimleri.Clear();
            if (_kayitlar.Count == 0)
                Snackbar.Add("Filtreye uyan kayıt bulunamadı.", Severity.Info);
            else
                Snackbar.Add($"{_kayitlar.Count} kayıt listelendi.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Sorgu hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _yukleniyor = false;
        }
    }

    private void FiltreSifirla()
    {
        _filtre = new EFaturaFiltre { Yon = _filtre.Yon };
        _bas = DateTime.Today.AddDays(-30);
        _bit = DateTime.Today;
        _kayitlar.Clear();
        _aktarimSecimleri.Clear();
    }

    private async Task DetayAc(EFaturaListItem r)
    {
        _detayAcik = true;
        _detayYukleniyor = true;
        _detay = null;
        _detayKarsiVkn = r.KarsiVKN ?? "";
        StateHasChanged();
        try
        {
            _detay = await Svc.DetayGetirAsync(r.Id, r.KarsiVKN);
            if (_detay == null)
                Snackbar.Add("XML ayrıştırılamadı.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Detay hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _detayYukleniyor = false;
            StateHasChanged();
        }
    }

    private async Task ExcelIndir()
    {
        if (_kayitlar.Count == 0) return;
        _excelYukleniyor = true;
        try
        {
            _filtre.Baslangic = _bas ?? DateTime.Today.AddDays(-30);
            _filtre.Bitis     = _bit ?? DateTime.Today;
            var bytes = ExcelExportService.ExportEFaturaListesi(_kayitlar, _filtre);
            var fileName = $"eFatura_{_filtre.Yon}_{_filtre.Baslangic:yyyyMMdd}_{_filtre.Bitis:yyyyMMdd}.xlsx";
            await JS.InvokeVoidAsync("downloadFile", fileName, Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Snackbar.Add($"{_kayitlar.Count} kayıt Excel'e aktarıldı.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Excel hatası: {ex.Message}", Severity.Error);
        }
        finally
        {
            _excelYukleniyor = false;
        }
    }

    private static string FormatBoyut(long b)
    {
        if (b < 1024) return $"{b} B";
        if (b < 1024 * 1024) return $"{b / 1024.0:N1} KB";
        return $"{b / (1024.0 * 1024.0):N2} MB";
    }

    private static Color RenkTip(string tip) => (tip ?? "").ToUpperInvariant() switch
    {
        "SATIS"        => Color.Success,
        "IADE"         => Color.Error,
        "TEVKIFAT"     => Color.Warning,
        "ISTISNA"      => Color.Secondary,
        "IHRACKAYITLI" => Color.Tertiary,
        "OZELMATRAH"   => Color.Info,
        "SEVK"         => Color.Default,
        "KABUL"        => Color.Primary,
        "RED"          => Color.Error,
        _              => Color.Default,
    };

    // ============================================================
    // SESLİ KOMUT
    // ============================================================

    private List<SesliKomutTool> _voiceTools => new()
    {
        new SesliKomutTool
        {
            Ad        = "yon_degistir",
            Aciklama  = "Gelen/Giden faturalar arasında geçiş.",
            Parametreler = new()
            {
                ["yon"] = new SesliKomutParam
                {
                    Tip = "string", Zorunlu = true,
                    Aciklama = "'gelen' veya 'giden'.",
                    Secenekler = new() { "gelen", "giden" },
                },
            }
        },
        new SesliKomutTool
        {
            Ad        = "tarih_ayarla",
            Aciklama  = "Tarih kutucuklarını doğrudan ayarlar. ISO yyyy-MM-dd. Sorgulamayı OTOMATİK yapmaz "
                      + "— komut_zinciri içinde sonra `sorgula` çağrılmalı.",
            Parametreler = new()
            {
                ["baslangic"] = new SesliKomutParam { Tip = "string", Aciklama = "Başlangıç tarihi (yyyy-MM-dd)." },
                ["bitis"]     = new SesliKomutParam { Tip = "string", Aciklama = "Bitiş tarihi (yyyy-MM-dd)." },
            }
        },
        new SesliKomutTool
        {
            Ad        = "tarih_araligi",
            Aciklama  = "Tarih aralığını kısayol enum ile ayarlar VE sorgular (bu ay, geçen ay, son 30 gün vb).",
            Parametreler = new()
            {
                ["aralik"] = new SesliKomutParam
                {
                    Tip = "string", Zorunlu = true,
                    Aciklama = "Hangi aralık.",
                    Secenekler = new() { "bugun", "dun", "bu_hafta", "bu_ay", "gecen_ay",
                                         "bu_yil", "son_7_gun", "son_30_gun", "son_90_gun" },
                },
            }
        },
        new SesliKomutTool
        {
            Ad        = "cari_filtre",
            Aciklama  = "Gönderen/Alıcı ünvanı, VKN, fatura no veya Logo cari kodu ile filtreleme. "
                      + "Kullanıcı 'X firmasının faturalarını göster', 'Doğuş Çay'a göre filtrele' gibi diyebilir. "
                      + "İlgili alanı doldur.",
            Parametreler = new()
            {
                ["unvan"]    = new SesliKomutParam { Tip = "string", Aciklama = "Karşı firma ünvanı (parçası — LIKE)." },
                ["vkn"]      = new SesliKomutParam { Tip = "string", Aciklama = "VKN veya TCKN." },
                ["fatura_no"] = new SesliKomutParam { Tip = "string", Aciklama = "Fatura numarası (parçası)." },
                ["logo_kod"] = new SesliKomutParam { Tip = "string", Aciklama = "Logo cari kodu (örn 320.06)." },
            }
        },
        new SesliKomutTool
        {
            Ad        = "filtre_sifirla",
            Aciklama  = "Tüm filtreleri sıfırlar. Kullanıcı 'temizle', 'sıfırla' derse.",
        },
        new SesliKomutTool
        {
            Ad        = "sorgula",
            Aciklama  = "Sorguyu çalıştırır.",
        },
    };

    private string VoiceContextOlustur()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Yön: {_filtre.Yon} (Gelen=gelen faturalar, Giden=biz kestiklerimiz)");
        sb.AppendLine($"Tarih: {_bas:dd.MM.yyyy} - {_bit:dd.MM.yyyy}");
        if (!string.IsNullOrWhiteSpace(_filtre.KarsiUnvan)) sb.AppendLine($"Ünvan filtresi: {_filtre.KarsiUnvan}");
        if (!string.IsNullOrWhiteSpace(_filtre.KarsiVKN))   sb.AppendLine($"VKN filtresi: {_filtre.KarsiVKN}");
        if (!string.IsNullOrWhiteSpace(_filtre.FaturaNo))   sb.AppendLine($"Fatura no filtresi: {_filtre.FaturaNo}");
        sb.AppendLine($"Listede {_kayitlar.Count} kayıt var.");
        return sb.ToString();
    }

    private async Task SesliAksiyonCalistir(VoiceIntent intent)
    {
        try
        {
            switch (intent.Action)
            {
                case "yon_degistir":
                {
                    var yon = (intent.Params.GetValueOrDefault("yon") as string ?? "").ToLower();
                    _filtre.Yon = yon == "giden" ? EFaturaYon.Giden : EFaturaYon.Gelen;
                    Snackbar.Add($"Yön: {_filtre.Yon}", Severity.Success);
                    await Sorgula();
                    break;
                }
                case "tarih_ayarla":
                {
                    var (b, t) = VoiceDateHelper.ParseBaslangicBitis(intent.Params, _bas, _bit);
                    _bas = b; _bit = t;
                    Snackbar.Add($"Tarih: {b:dd.MM.yyyy} - {t:dd.MM.yyyy}", Severity.Success);
                    break;
                }
                case "tarih_araligi":
                {
                    var (b, t) = VoiceDateHelper.AraligiCevir(intent.Params.GetValueOrDefault("aralik") as string);
                    if (b == null) { Snackbar.Add("Aralık anlaşılamadı.", Severity.Warning); return; }
                    _bas = b; _bit = t;
                    Snackbar.Add($"Tarih: {b:dd.MM.yyyy} - {t:dd.MM.yyyy}", Severity.Success);
                    await Sorgula();
                    break;
                }
                case "cari_filtre":
                {
                    var unvan    = intent.Params.GetValueOrDefault("unvan")    as string;
                    var vkn      = intent.Params.GetValueOrDefault("vkn")      as string;
                    var faturaNo = intent.Params.GetValueOrDefault("fatura_no") as string;
                    var logoKod  = intent.Params.GetValueOrDefault("logo_kod") as string;
                    if (!string.IsNullOrWhiteSpace(unvan))    _filtre.KarsiUnvan    = unvan;
                    if (!string.IsNullOrWhiteSpace(vkn))      _filtre.KarsiVKN      = vkn;
                    if (!string.IsNullOrWhiteSpace(faturaNo)) _filtre.FaturaNo      = faturaNo;
                    if (!string.IsNullOrWhiteSpace(logoKod))  _filtre.LogoCariKodu  = logoKod;
                    Snackbar.Add("Filtre uygulandı.", Severity.Success);
                    await Sorgula();
                    break;
                }
                case "filtre_sifirla":
                    FiltreSifirla();
                    Snackbar.Add("Filtreler sıfırlandı.", Severity.Info);
                    break;
                case "sorgula":
                    await Sorgula();
                    break;
                default:
                    Snackbar.Add($"Bilinmeyen aksiyon: {intent.Action}", Severity.Warning);
                    break;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Aksiyon hatası: {ex.Message}", Severity.Error);
        }
    }

    private static (DateTime? bas, DateTime? bit) TarihAraligiCevir(string kod)
    {
        var bugun = DateTime.Today;
        return kod switch
        {
            "bugun"      => ((DateTime?)bugun, (DateTime?)bugun),
            "dun"        => (bugun.AddDays(-1), bugun.AddDays(-1)),
            "bu_hafta"   => (bugun.AddDays(-(((int)bugun.DayOfWeek + 6) % 7)), bugun),
            "bu_ay"      => (new DateTime(bugun.Year, bugun.Month, 1), bugun),
            "gecen_ay"   => (new DateTime(bugun.Year, bugun.Month, 1).AddMonths(-1),
                             new DateTime(bugun.Year, bugun.Month, 1).AddDays(-1)),
            "bu_yil"     => (new DateTime(bugun.Year, 1, 1), bugun),
            "son_7_gun"  => (bugun.AddDays(-7),  bugun),
            "son_30_gun" => (bugun.AddDays(-30), bugun),
            "son_90_gun" => (bugun.AddDays(-90), bugun),
            _ => (null, null),
        };
    }
}
